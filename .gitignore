# Environment (never commit secrets)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
dist-ssr/
**/dist/
.output
.wrangler
.vite/
*.local

# Backend runtime data (server-only)
backend/uploads/*
!backend/uploads/.gitkeep
backend/**/*.db
backend/**/*.db-journal
backend/**/*.db-shm
backend/**/*.db-wal
*.db
*.db-journal
*.db-shm
*.db-wal

# Prisma generated / cache (regenerated by prisma generate)
backend/node_modules/.prisma/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pm2*.log

# Process managers / deploy leftovers
.pm2/
*.pid
.turbo/
.cache/
coverage/
tmp/
temp/
.temp/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Misc
base44/.app.jsonc
