generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(cuid())
  email           String?              @unique
  phone           String?              @unique
  googleId        String?              @unique
  passwordHash    String?
  fullName        String?
  role            String               @default("user")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  addresses       Address[]
  resetTokens     PasswordResetToken[]
  aiConversations AIConversation[]
  aiFiles         AIFile[]
  aiUsage         AIUsage[]
  aiMemories      AIMemory[]
  media           Media[]
}

/// یک‌بارمصرف و زمان‌دار — برای بازیابی رمز عبور
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  fullName   String?
  phone      String?
  province   String?
  city       String?
  address    String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model CurtainModel {
  id             String   @id @default(cuid())
  code           String
  name           String
  categorySlug   String
  subcategory    String?
  fabric         String?
  color          String?
  colorCode      String?
  material       String?
  texture        String?
  image          String?
  installImage   String?
  installStatus  String?
  installScore   Float?
  installReview  String?
  installPending String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// SEO
  seoTitle         String?
  seoDescription   String?
  seoCanonicalUrl  String?
  seoRobots        String?
  seoOgTitle       String?
  seoOgDescription String?
  seoOgImage       String?
  seoTwitterCard   String?
  seoTwitterTitle  String?
  seoTwitterDescription String?
  seoTwitterImage  String?

  relatedProjects Project[] @relation("CurtainModelRelatedProjects")

  @@index([categorySlug])
  @@index([code])
}

model CurtainCategory {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  image           String?
  order           Int      @default(0)
  subcategories   String?
  inCatalog       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mechanism       String?
  // هارمونی بافت و رنگ - پس‌زمینه کارت‌ها در سکشن فابریک لایبرری
  backgroundImage String?
  backgroundGradient String?

  /// SEO
  seoTitle         String?
  seoDescription   String?
  seoCanonicalUrl  String?
  seoRobots        String?
  seoOgTitle       String?
  seoOgDescription String?
  seoOgImage       String?
  seoTwitterCard   String?
  seoTwitterTitle  String?
  seoTwitterDescription String?
  seoTwitterImage  String?

  collections     CollectionCategory[]
}

model PortfolioCategory {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  image         String?
  order         Int      @default(0)
  subcategories String?
  createdAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// SEO
  seoTitle         String?
  seoDescription   String?
  seoCanonicalUrl  String?
  seoRobots        String?
  seoOgTitle       String?
  seoOgDescription String?
  seoOgImage       String?
  seoTwitterCard   String?
  seoTwitterTitle  String?
  seoTwitterDescription String?
  seoTwitterImage  String?
}

model Project {
  id           String   @id @default(cuid())
  title        String
  description  String?
  coverImage   String?
  images       String?
  categorySlug String   @default("")
  subcategory  String?
  relatedProducts Product[] @relation("ProductRelatedProjects")
  relatedCurtainModels CurtainModel[] @relation("CurtainModelRelatedProjects")
  collections    CollectionProject[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// SEO
  seoTitle         String?
  seoDescription   String?
  seoCanonicalUrl  String?
  seoRobots        String?
  seoOgTitle       String?
  seoOgDescription String?
  seoOgImage       String?
  seoTwitterCard   String?
  seoTwitterTitle  String?
  seoTwitterDescription String?
  seoTwitterImage  String?

  @@index([categorySlug])
}

model ConsultationRequest {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  city      String?
  spaceType String?
  message   String?
  reference String?
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model RenderTemplate {
  id        String   @id @default(cuid())
  style     String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([style])
}

model InstallReference {
  id        String   @id @default(cuid())
  style     String
  image     String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([style])
}

model SavedDesign {
  id               String   @id @default(cuid())
  title            String
  image            String
  curtainStyle     String?
  curtainModelId   String?
  curtainModelCode String?
  color            String?
  designerName     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Collection (مجموعه) — first-class entity for grouping products, categories, and projects
model Collection {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  coverImage  String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// SEO
  seoTitle         String?
  seoDescription   String?
  seoCanonicalUrl  String?
  seoRobots        String?
  seoOgTitle       String?
  seoOgDescription String?
  seoOgImage       String?
  seoTwitterCard   String?
  seoTwitterTitle  String?
  seoTwitterDescription String?
  seoTwitterImage  String?

  products    CollectionProduct[]
  categories  CollectionCategory[]
  projects    CollectionProject[]

  @@index([active, order])
  @@index([slug])
}

/// Many-to-many: Collection <-> Product
model CollectionProduct {
  id            String      @id @default(cuid())
  collectionId  String
  collection    Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

/// Many-to-many: Collection <-> CurtainCategory (catalog categories)
model CollectionCategory {
  id            String         @id @default(cuid())
  collectionId  String
  collection    Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  categoryId    String
  category      CurtainCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@unique([collectionId, categoryId])
  @@index([collectionId])
  @@index([categoryId])
}

/// Many-to-many: Collection <-> Project (portfolio projects)
model CollectionProject {
  id            String   @id @default(cuid())
  collectionId  String
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([collectionId, projectId])
  @@index([collectionId])
  @@index([projectId])
}

model VirtualWindowSetting {
  id         String   @id @default(cuid())
  wallColor  String?
  frameColor String?
  railColor  String?
  viewImage  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Site-wide settings including SEO configuration.
model SiteSetting {
  id         String   @id @default(cuid())
  key        String   @unique @default("main")
  logoUrl    String?
  heroSlides String?
  pageHeroes String?
  /// SEO
  seoTitle       String?
  seoDescription   String?
  seoKeywords      String?
  canonicalUrl     String?
  robotsPolicy     String?   // e.g. "index, follow" or "noindex, nofollow"
  ogTitle          String?
  ogDescription    String?
  ogImage          String?
  twitterCard      String?   // e.g. "summary_large_image"
  twitterTitle     String?
  twitterDescription String?
  twitterImage     String?
  organizationName String?
  organizationLogo String?
  sitemapEnabled   Boolean   @default(true)
  verificationGoogle String?
  verificationBing   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  price          Float    @default(0)
  compareAtPrice Float?
  currency       String   @default("IRR")
  image          String?
  gallery        String?
  categoryId     String?
  visible        Boolean  @default(true)
  inStock        Boolean  @default(true)
  stock          Int      @default(100)
  ribbon         String?
  optionsJson    String?
  variantsJson   String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// SEO
  seoTitle         String?
  seoDescription   String?
  seoCanonicalUrl  String?
  seoRobots        String?   // e.g. "index, follow" or "noindex, nofollow"
  seoOgTitle       String?
  seoOgDescription String?
  seoOgImage       String?
  seoTwitterCard   String?   // e.g. "summary_large_image"
  seoTwitterTitle  String?
  seoTwitterDescription String?
  seoTwitterImage  String?

  relatedProjects   Project[]             @relation("ProductRelatedProjects")
  collections       CollectionProduct[]

  @@index([categoryId])
  @@index([visible])
}

model ShopCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  visible     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// SEO
  seoTitle         String?
  seoDescription   String?
  seoCanonicalUrl  String?
  seoRobots        String?
  seoOgTitle       String?
  seoOgDescription String?
  seoOgImage       String?
  seoTwitterCard   String?
  seoTwitterTitle  String?
  seoTwitterDescription String?
  seoTwitterImage  String?
}

/// Persistent admin AI workspace conversation.
model AIConversation {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String          @default("گفتگوی جدید")
  provider  String?         // null = unassigned until first inference request
  model     String?         // null = unassigned until first inference request
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  AIChatMessage[]
  files     AIFile[]
  memories  AIMemory[]

  @@index([userId, updatedAt])
}

/// A user or assistant UI message. UI parts are stored as JSON because
/// SQLite/Prisma models in this project do not use a JSON column type.
model AIChatMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  partsJson      String         @default("[]")
  provider       String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

/// Private workspace file. storagePath is never exposed as a public URL.
model AIFile {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  kind           String          @default("input")
  originalName   String
  mimeType       String
  size           Int
  storagePath    String
  sha256         String?
  requestKey     String?         @unique
  provider       String?
  model          String?
  prompt         String?
  metadataJson   String?
  createdAt      DateTime        @default(now())

  @@index([userId, conversationId, kind])
  @@index([createdAt])
}

/// Per-request usage ledger used for daily limits and admin reporting.
model AIUsage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  model         String
  operation     String
  status        String   @default("success")
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  units         Int      @default(1)
  estimatedCost Float    @default(0)
  errorCode     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, operation, createdAt])
}

/// Long-term persistent memory for the AI assistant.
model AIMemory {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String?
  conversation    AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  type            String      // preference | fact | project_context | communication_style | decision | correction
  category        String?     // e.g., "curtain_catalog", "shop", "projects", "user_preferences"
  content         String      // The actual memory content
  sourceMessageId String?     // Reference to the message that created this memory
  confidence      Float       @default(0.8) // 0.0 - 1.0, how confident we are this is accurate
  importance      Int         @default(1)   // 1-5, higher = more important for retrieval
  expiresAt       DateTime?   // Optional expiration for temporary memories
  metadataJson    String?     // Additional structured data
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, type])
  @@index([userId, category])
  @@index([userId, importance])
  @@index([userId, createdAt])
  @@index([conversationId])
}

/// Central media library — one canonical record per uploaded image.
/// Every image field across entities can reference Media via MediaUsage.
model Media {
  id          String   @id @default(cuid())
  /// Stored filename on disk (under uploads/media/...)
  filename    String
  originalName String
  mimeType    String   // image/jpeg | image/png | image/webp | image/gif | image/svg+xml | image/bmp | image/tiff | image/vnd.microsoft.icon
  size        Int      // bytes (original file size)
  width       Int?
  height      Int?
  /// Relative path under the upload dir, e.g. media/2026/11/abcd1234.jpg
  storagePath String
  /// Public URL served by /uploads static middleware, e.g. /uploads/media/.../abcd1234.jpg
  url         String
  /// Public URL of WebP derivative (for raster images) or WebP derivative of SVG
  webpUrl     String?
  /// Size of WebP derivative in bytes
  webpSize    Int?
  /// Original file size before WebP conversion (same as size for non-WebP uploads)
  originalSize Int?
  /// Original MIME type before conversion (e.g. image/jpeg for a WebP derivative)
  originalMimeType String?
  sha256      String?   @unique // content hash for deduplication
  alt         String?
  caption     String?
  title       String?
  uploadedById String?
  uploadedBy  User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  usages      MediaUsage[]

  @@index([uploadedById])
  @@index([sha256])
  @@index([mimeType])
  @@index([createdAt])
  @@index([url])
  @@index([webpUrl])
}

/// Join-like usage log: which entity field references which media.
/// Used for the "delete with usage check" guard and for back-filling alt/caption.
model MediaUsage {
  id        String   @id @default(cuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  /// e.g. "CurtainCategory" | "CurtainModel" | "Product" | "PortfolioCategory" |
  ///      "Project" | "RenderTemplate" | "InstallReference" | "SavedDesign" |
  ///      "Collection" | "VirtualWindowSetting" | "SiteSetting" | "ShopCategory"
  entityType String
  entityId  String
  /// e.g. "image" | "gallery" | "backgroundImage" | "coverImage" | "viewImage" | "logoUrl" | "heroSlides" | "pageHeroes"
  fieldName String
  createdAt DateTime @default(now())

  @@index([mediaId])
  @@index([entityType, entityId])
  @@index([entityType, entityId, fieldName])
  @@unique([mediaId, entityType, entityId, fieldName])
}
