PORT=3001
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
CORS_ORIGIN="https://your-domain.example"
FRONTEND_URL="https://your-domain.example"
UPLOAD_DIR="./uploads"
PUBLIC_BASE_URL="https://your-domain.example"
ADMIN_EMAIL="admin@your-domain.example"
ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-chars"

# Payments: use a real production merchant ID. Without it checkout fails closed (503).
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX=false
ZARINPAL_DEMO_MODE=false

# OTP mobile — leave empty to disable external OTP provider
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""

# Private AI workspace files
AI_PRIVATE_DIR="./data/ai"

# Required shared secret: use the identical random value in Cloudflare Worker secret MCP_WORKER_TOKEN.
MCP_WORKER_TOKEN="replace-with-a-long-random-secret"

# Cloudflare Workers AI / AI Gateway
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_AI_GATEWAY_ID="nvidia-m"
AI_ENABLE_CLOUDFLARE=true

# NVIDIA NIM — configure a fresh key in this file only; do not paste it into source control or chat.
NVIDIA_API_KEY=""
AI_ENABLE_NVIDIA=true

# Optional providers; enable only after adding their API keys and verifying their free-tier limits.
GOOGLE_GENERATIVE_AI_API_KEY=""
AI_ENABLE_GOOGLE=false
OPENROUTER_API_KEY=""
AI_ENABLE_OPENROUTER=false

# Conservative local usage guards. Workers AI free allocation is 10,000 Neurons/day.
AI_MAX_OUTPUT_TOKENS=2500
AI_DAILY_CHAT_REQUESTS=50
AI_DAILY_IMAGE_REQUESTS=10
AI_DAILY_IMAGE_COUNT=10
AI_DAILY_TOTAL_TOKENS=200000
AI_CLOUDFLARE_DAILY_QUOTA_UNITS=9000
AI_NVIDIA_DAILY_CREDITS=1000

# Optional SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
