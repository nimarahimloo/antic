PORT=3001
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string-in-production"
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
UPLOAD_DIR="./uploads"
PUBLIC_BASE_URL="http://localhost:3001"
ADMIN_EMAIL="admin@antic.local"
ADMIN_PASSWORD="admin123"

# زرین‌پال — خالی بگذار تا حالت دمو (بدون درگاه واقعی)
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

# OTP موبایل — خالی = حالت نمایشی (کد در پاسخ API)
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""

# فضای کاری هوش مصنوعی (ادمین)
# فایل‌های خصوصی این بخش هرگز زیر /uploads عمومی سرو نمی‌شوند.
AI_PRIVATE_DIR="./data/ai"

# Required shared secret: set the same random value as the Cloudflare Worker secret
# named MCP_WORKER_TOKEN. Never commit the real value.
MCP_WORKER_TOKEN=""

# Cloudflare Workers AI — ارائه‌دهندهٔ پیش‌فرض گفتگو و تصویر
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_AI_GATEWAY_ID="nvidia-m"
AI_ENABLE_CLOUDFLARE=true

# Google Gemini فقط مدل‌های Free و فقط با فعال‌سازی صریح
GOOGLE_GENERATIVE_AI_API_KEY=""
AI_ENABLE_GOOGLE=false

# OpenRouter فقط مدل‌های :free و فقط با فعال‌سازی صریح
OPENROUTER_API_KEY=""
AI_ENABLE_OPENROUTER=false

# کنترل مصرف و پاسخ (بازهٔ روزانه بر اساس UTC)
AI_MAX_OUTPUT_TOKENS=2500
AI_DAILY_CHAT_REQUESTS=50
AI_DAILY_IMAGE_REQUESTS=10
AI_DAILY_TOTAL_TOKENS=200000
# بودجهٔ محافظه‌کارانه برای سهمیٔ مشترک روزانهٔ Workers AI (Neurons)
# Workers AI FREE TIER = 10,000 neurons/day. هرگز از این مقدار بالاتر نrollersید.
AI_CLOUDFLARE_DAILY_QUOTA_UNITS=9000
