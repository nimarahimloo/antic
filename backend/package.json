{
  "name": "antic-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:import-woo": "node scripts/import-woocommerce-sql.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test:functional": "node scripts/functional-test.mjs",
    "test": "node scripts/smoke-test.mjs && node scripts/functional-test.mjs",
    "render:batch": "tsx scripts/run-batch.ts",
    "chroma:ensure": "node scripts/ensure-chroma.mjs",
    "postdeploy": "node scripts/ensure-chroma.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "prisma": "^6.5.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
