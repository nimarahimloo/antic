{
  "name": "antic-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "db:import-woo": "node scripts/import-woocommerce-sql.mjs",
    "db:import-curtains": "node scripts/import-curtains-csv.mjs",
    "db:import-accessories": "node scripts/import-accessories-csv.mjs",
    "smoke": "tsx scripts/smoke-test.mjs",
    "test:functional": "tsx scripts/functional-test.mjs",
    "test:mcp:integration": "node --import tsx --test scripts/mcp-integration.test.mjs",
    "test": "tsx scripts/smoke-test.mjs && tsx scripts/functional-test.mjs",
    "render:batch": "tsx scripts/run-batch.ts",
    "chroma:ensure": "node scripts/ensure-chroma.mjs",
    "typecheck": "tsc --noEmit",
    "postdeploy": "node scripts/ensure-chroma.mjs",
    "restore:admin": "node scripts/restore-adminActions.mjs",
    "test:order-pricing": "node --import tsx --test scripts/order-pricing.test.mjs",
    "test:payment-security": "node --import tsx --test scripts/payment-security.test.mjs",
    "test:ai-provider-gating": "node --import tsx --test scripts/ai-provider-gating.test.mjs",
    "test:media:validation": "node --import tsx scripts/media-validation.test.mjs",
    "test:media:routes": "BASE=http://localhost:3001 node --import tsx scripts/media-routes.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@prisma/client": "^6.5.0",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/nodemailer": "^8.0.2",
    "@x402/express": "^2.32.0",
    "ai": "^7.0.179",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dompurify": "^3.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsdom": "^31.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "nodemailer": "^10.6.1",
    "prisma": "^6.5.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
